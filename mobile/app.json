{
  "expo": {
    "name": "My Frontier",
    "slug": "myfrontier",
    "version": "1.0.0",
    "description": "Smart ETF portfolio optimizer built on Efficient Frontier mathematics. Built for first-time investors.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1f3a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myfrontier.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.myfrontier.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1f3a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "privacy": "https://myfrontierapp.com/privacy",
    "extra": {
      "keywords": ["ETF", "investing", "portfolio", "stocks", "finance", "retirement"],
      "privacyPolicyUrl": "https://ashtonwhales-del.github.io/my-frontier/privacy-policy.html",
      "supportUrl": "https://ashtonwhales-del.github.io/my-frontier/support.html",
      "eas": {
        "projectId": "755ee3d0-24e3-4364-99e9-2916c76e8ae3"
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8834917370871405~7924668226",
          "iosAppId": "ca-app-pub-8834917370871405~7924668226"
        }
      ]
    ]
  }
}
